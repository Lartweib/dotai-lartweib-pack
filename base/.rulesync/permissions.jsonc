{
  // Base secrets, user scope (DESIGN §3, confirmed 2026-10-31; pack 0038). The same list as
  // base/dotai/tools/deny-paths.base.txt, which the shell guard reads; keep both in step (a test
  // in base/tests/wiring.test.mjs checks it). Only reads are denied.
  //
  // No shared categories: rulesync 41.0.0 passes patterns through, and each harness reads them
  // differently, so each has its own block (a tool-scoped category replaces the shared one).
  //   Claude Code  gitignore patterns (a bare name matches at any depth, `~/` is the home
  //                directory, measurement 9). There is no `!` and deny wins over allow, so
  //                `.env.*` is spelled out per file, which keeps `.env.example` readable.
  //   OpenCode     wildcards over the path, last matching rule wins; this is OpenCode's own
  //                default read block plus the secrets. `~/` is expanded (OpenCode 2.0.30, trial
  //                2026-11-04); v2 reads rulesync's `permissions` list as its native shape.
  //   agy          plain paths only, absolute or relative to the workspace; a glob matches
  //                nothing, so `.env.*` is spelled out per file as for Claude Code, and the other
  //                glob entries are covered by the shell and read guards alone. A relative path
  //                matches only at the workspace root: `.env` does not deny `sub/.env`, and
  //                `**/.env` denies nothing (agy 1.4.12, trial 2026-11-04). For nested secrets
  //                read-guard is the only control on agy.
  //                agy does not expand `~/` (agy 1.4.12, trial 2026-11-03), so its home paths
  //                use `${DOTAI_HOME}`, which the engine turns into the real home directory with
  //                forward slashes while staging (dotai PACK-FORMAT); read-guard covers them too.
  "permission": {},
  "claudecode": {
    "permission": {
      "read": {
        ".env": "deny",
        ".env.local": "deny",
        ".env.*.local": "deny",
        ".env.dev": "deny",
        ".env.development": "deny",
        ".env.prod": "deny",
        ".env.production": "deny",
        ".env.preview": "deny",
        ".env.staging": "deny",
        ".env.test": "deny",
        "*.pem": "deny",
        "*.key": "deny",
        "id_rsa*": "deny",
        "~/.ssh/**": "deny",
        "~/.aws/**": "deny",
        "~/.config/gcloud/**": "deny",
        "~/.wrangler/**": "deny",
        "~/.claude/.credentials.json": "deny",
        "~/.gemini/oauth_creds.json": "deny"
      }
    }
  },
  "opencode": {
    "permission": {
      "read": {
        "*": "allow",
        "*.env": "deny",
        "*.env.*": "deny",
        "*.pem": "deny",
        "*.key": "deny",
        "*id_rsa*": "deny",
        "~/.ssh/*": "deny",
        "~/.aws/*": "deny",
        "~/.config/gcloud/*": "deny",
        "~/.wrangler/*": "deny",
        "~/.claude/.credentials.json": "deny",
        "~/.gemini/oauth_creds.json": "deny",
        "*.env.example": "allow"
      }
    }
  },
  "antigravity-cli": {
    "permission": {
      "read": {
        ".env": "deny",
        ".env.local": "deny",
        ".env.dev": "deny",
        ".env.development": "deny",
        ".env.prod": "deny",
        ".env.production": "deny",
        ".env.preview": "deny",
        ".env.staging": "deny",
        ".env.test": "deny",
        "${DOTAI_HOME}/.ssh": "deny",
        "${DOTAI_HOME}/.aws": "deny",
        "${DOTAI_HOME}/.config/gcloud": "deny",
        "${DOTAI_HOME}/.wrangler": "deny",
        "${DOTAI_HOME}/.claude/.credentials.json": "deny",
        "${DOTAI_HOME}/.gemini/oauth_creds.json": "deny"
      }
    }
  }
}
